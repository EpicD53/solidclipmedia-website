---
import Layout from "../layouts/Layout.astro";

const realEstateProjects = [
  {
    title: "1.4M Dollar Toronto Property",
    category: "REAL ESTATE VIDEOGRAPHY",
    description:
      "A cinematic property tour highlighting the home's layout, architectural details, and inviting living spaces. Thoughtful camera movements and professional editing bring the property to life, helping potential buyers envision themselves at home.",
    videoId: "OhCdd8lTclk",
  },
  {
    title: "Flipping a 3-bed Semi in Burlington",
    category: "PROPERTY MARKETING",
    description:
      "Join Taras as he walks through a newly renovated three-bedroom semi-detached home in Burlington, showcasing the transformation, thoughtful upgrades, and finishing details. Through engaging walkthrough footage and professional editing, we bring the renovation to life, highlighting the craftsmanship and work behind the finished property.",
    videoId: "8Zt4yTqiZ7s",
  },
];

const matterportUrl = "https://my.matterport.com/show/?m=6uwxQrwWSNR";
---

<Layout
  title="Real Estate Videography | Solid Clip Media"
  description="Professional real estate videography and interactive 3D property tours in Toronto and the GTA. Cinematic property videos and Matterport virtual tours by Solid Clip Media."
>
  <main class="realestate-page">
    <!-- INTRO + PORTFOLIO -->
    <section class="realestate-projects">
      <div class="realestate-projects-heading">
        <span class="realestate-label">SOLID CLIP MEDIA</span>

        <h1>Real Estate Videography</h1>

        <p>
          Every property has a story worth telling. Through cinematic
          videography and immersive virtual tours, we showcase spaces in their
          best light, helping real estate professionals capture attention and
          make lasting impressions.
        </p>
      </div>

      <!-- PROPERTY VIDEOS -->
      <div class="realestate-video-grid">
        {
          realEstateProjects.map((project) => (
            <article class="realestate-card">
              <button
                type="button"
                class="realestate-video film-thumbnail"
                data-video-id={project.videoId}
                aria-label={`Play ${project.title}`}
              >
                <img
                  src={`https://img.youtube.com/vi/${project.videoId}/maxresdefault.jpg`}
                  alt={`${project.title} Video`}
                  loading="lazy"
                />

                <span class="play-button">▶</span>
              </button>

              <div class="realestate-card-info">
                <span class="realestate-category">{project.category}</span>

                <h3>{project.title}</h3>

                <p>{project.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- MATTERPORT 3D TOUR -->
    <section class="realestate-virtual-tour">
      <div class="realestate-tour-heading">
        <span class="realestate-label">GO BEYOND VIDEO</span>

        <h2>Explore Virtual Tours.</h2>

        <p>
          Give potential buyers the freedom to explore a property from anywhere.
          Our interactive 3D virtual tours allow viewers to move through rooms,
          examine details, and experience the space at their own pace.
        </p>
      </div>

      <div class="realestate-matterport-container">
        <iframe
          src={matterportUrl}
          title="Interactive 3D Property Tour"
          loading="lazy"
          allow="autoplay; fullscreen; web-share; xr-spatial-tracking"
          allowfullscreen></iframe>
      </div>

      <p class="realestate-tour-note">
        Interactive 3D Tour — Click and drag to explore the property.
      </p>
    </section>

    <!-- CORPORATE INQUIRY FORM -->
    <section class="corporate-inquiry" id="corporate-inquiry">
      <div class="corporate-inquiry-container">
        <!-- HEADING -->
        <div class="corporate-inquiry-heading">
          <span class="corporate-inquiry-label">LET'S WORK TOGETHER</span>

          <h2>Make Your Listing Stand Out.</h2>

          <p>
            Whether you're marketing a residential property, showcasing a
            commercial space, or looking to offer immersive virtual tours, let's
            create something that makes an impression.
          </p>
        </div>

        <form
          name="corporate-inquiry"
          method="POST"
          action="/thank-you"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="corporate-inquiry-form"
        >
          <input type="hidden" name="form-name" value="corporate-inquiry" />

          <!-- Spam protection -->
          <p class="corporate-honeypot">
            <label>
              Don't fill this out:
              <input name="bot-field" />
            </label>
          </p>

          <!-- NAME + EMAIL -->
          <div class="corporate-form-row">
            <div class="corporate-form-field">
              <label for="corporate-name">Your Name *</label>

              <input
                type="text"
                id="corporate-name"
                name="name"
                placeholder="John Smith"
                autocomplete="name"
                required
              />
            </div>

            <div class="corporate-form-field">
              <label for="corporate-email">Email Address *</label>

              <input
                type="email"
                id="corporate-email"
                name="email"
                placeholder="john@example.com"
                autocomplete="email"
                required
              />
            </div>
          </div>

          <!-- PHONE NUMBER -->
          <div class="corporate-form-field">
            <label for="corporate-phone">Phone Number</label>

            <input
              type="tel"
              id="corporate-phone"
              name="phone"
              placeholder="(416) 555-1234"
              autocomplete="tel"
            />
          </div>

          <!-- PROJECT DETAILS -->
          <div class="corporate-form-field">
            <label for="corporate-message">Tell Us About Your Project *</label>

            <textarea
              id="corporate-message"
              name="message"
              rows="5"
              placeholder="Tell us a little about your project, what you're hoping to achieve, and any other important details..."
              required></textarea>
          </div>

          <!-- SUBMIT BUTTON -->
          <button type="submit" class="corporate-form-submit">
            Send Your Inquiry
            <span aria-hidden="true">↗</span>
          </button>

          <p class="corporate-form-note">
            No commitment required. We'll review your project details and get
            back to you to discuss the next steps.
          </p>
          <p class="contact-alternative">
            Prefer email?&nbsp;
            <a href="mailto:solidclipmedia@gmail.com">
              solidclipmedia@gmail.com
            </a>
          </p>
        </form>
      </div>
    </section>
  </main>
</Layout>

<!-- VIDEO LIGHTBOX -->
<div
  id="video-lightbox"
  class="video-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Real estate video player"
  aria-hidden="true"
  tabindex="-1"
>
  <button type="button" class="lightbox-close" aria-label="Close video">
    &times;
  </button>

  <div class="lightbox-video-container">
    <iframe
      id="lightbox-player"
      title="Real estate video"
      src=""
      allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
      allowfullscreen></iframe>
  </div>
</div>

<script>
  const lightbox = document.getElementById("video-lightbox");

  const player = document.getElementById(
    "lightbox-player",
  ) as HTMLIFrameElement | null;

  const closeButton = document.querySelector(
    ".lightbox-close",
  ) as HTMLButtonElement | null;

  const videoButtons = document.querySelectorAll(
    ".film-thumbnail[data-video-id]",
  );

  let previousFocus: HTMLElement | null = null;

  function openLightbox(videoId: string) {
    if (!lightbox || !player) return;

    previousFocus = document.activeElement as HTMLElement;

    player.src =
      `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}` +
      `?autoplay=1&rel=0&playsinline=1`;

    lightbox.classList.add("active");
    lightbox.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";

    closeButton?.focus();
  }

  function closeLightbox() {
    if (!lightbox || !player) return;

    lightbox.classList.remove("active");
    lightbox.setAttribute("aria-hidden", "true");

    player.src = "";

    document.body.style.overflow = "";

    previousFocus?.focus();
  }

  videoButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const videoId = (button as HTMLElement).dataset.videoId;

      if (videoId) {
        openLightbox(videoId);
      }
    });
  });

  closeButton?.addEventListener("click", closeLightbox);

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (!lightbox?.classList.contains("active")) return;

    if (event.key === "Escape") {
      closeLightbox();
    }

    if (event.key === "Tab") {
      event.preventDefault();
      closeButton?.focus();
    }
  });
</script>
