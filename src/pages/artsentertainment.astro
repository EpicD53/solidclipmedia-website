---
import Layout from "../layouts/Layout.astro";

const artsProjects = [
  {
    title: "Barvinok Ukrainian Dance School",
    category: "LIVE PERFORMANCE COVERAGE",
    description:
      "Capturing the atmosphere, energy, and emotion of Barvinok's 2026 Year End Concert live performance. Through cinematic camera angles and thoughtful editing, we preserve the excitement of the stage and the connection between performers and their audience.",
    videoId: "wU6yHcGsSsc",
  },
  {
    title: "Zlata Barchuk - Колискова мелодія України",
    category: "MUSIC VIDEO PRODUCTION",
    description:
      "Bringing music to life through creative cinematography, dynamic visuals, and carefully crafted editing. A visual production working alongside Zlata Barchuk, designed to complement the artist's sound and creative vision.",
    videoId: "HnqW_SdHOAw",
  },
];
---

<Layout
  title="Arts & Entertainment Videography | Solid Clip Media"
  description="Professional music video production, live performance filming, and arts and entertainment videography in Toronto and the GTA."
>
  <main class="arts-page">
    <!-- INTRO + PORTFOLIO -->
    <section class="arts-projects">
      <div class="arts-projects-heading">
        <span class="arts-label">SOLID CLIP MEDIA</span>

        <h1>Arts & Entertainment</h1>

        <p>
          From the energy of live performances to the creativity of music
          videos, we bring artistic visions to life through cinematic
          storytelling. Every production is an opportunity to capture the
          passion, talent, and emotion behind the performance.
        </p>
      </div>

      <!-- VIDEO GRID -->
      <div class="arts-video-grid">
        {
          artsProjects.map((project) => (
            <article class="arts-card">
              <button
                type="button"
                class="arts-video film-thumbnail"
                data-video-id={project.videoId}
                aria-label={`Play ${project.title}`}
              >
                <img
                  src={`https://img.youtube.com/vi/${project.videoId}/maxresdefault.jpg`}
                  alt={`${project.title} Video`}
                  loading="lazy"
                />

                <span class="play-button">▶</span>
              </button>

              <div class="arts-card-info">
                <span class="arts-category">{project.category}</span>

                <h3>{project.title}</h3>

                <p>{project.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- INQUIRY FORM -->
    <section class="corporate-inquiry" id="corporate-inquiry">
      <div class="corporate-inquiry-container">
        <!-- HEADING -->
        <div class="corporate-inquiry-heading">
          <span class="corporate-inquiry-label">LET'S WORK TOGETHER</span>

          <h2>Bring Your Vision to Life.</h2>

          <p>
            Whether you're producing a music video, organizing a live
            performance, or bringing a creative project to the stage, let's
            capture something unforgettable.
          </p>
        </div>

        <form
          name="artsentertainment-inquiry"
          method="POST"
          action="/thank-you"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="corporate-inquiry-form"
        >
          <input
            type="hidden"
            name="form-name"
            value="artsentertainment-inquiry"
          />

          <!-- Spam protection -->
          <p class="corporate-honeypot">
            <label>
              Don't fill this out:
              <input name="bot-field" />
            </label>
          </p>

          <!-- NAME + EMAIL -->
          <div class="corporate-form-row">
            <div class="corporate-form-field">
              <label for="corporate-name">Your Name *</label>

              <input
                type="text"
                id="corporate-name"
                name="name"
                placeholder="John Smith"
                autocomplete="name"
                required
              />
            </div>

            <div class="corporate-form-field">
              <label for="corporate-email">Email Address *</label>

              <input
                type="email"
                id="corporate-email"
                name="email"
                placeholder="john@example.com"
                autocomplete="email"
                required
              />
            </div>
          </div>

          <!-- PHONE NUMBER -->
          <div class="corporate-form-field">
            <label for="corporate-phone">Phone Number</label>

            <input
              type="tel"
              id="corporate-phone"
              name="phone"
              placeholder="(416) 555-1234"
              autocomplete="tel"
            />
          </div>

          <!-- PROJECT DETAILS -->
          <div class="corporate-form-field">
            <label for="corporate-message">Tell Us About Your Project *</label>

            <textarea
              id="corporate-message"
              name="message"
              rows="5"
              placeholder="Tell us a little about your project, what you're hoping to achieve, and any other important details..."
              required></textarea>
          </div>

          <!-- SUBMIT BUTTON -->
          <button type="submit" class="corporate-form-submit">
            Send Your Inquiry
            <span aria-hidden="true">↗</span>
          </button>

          <p class="corporate-form-note">
            No commitment required. We'll review your project details and get
            back to you to discuss the next steps.
          </p>
          <p class="contact-alternative">
            Prefer email?&nbsp;
            <a href="mailto:solidclipmedia@gmail.com">
              solidclipmedia@gmail.com
            </a>
          </p>
        </form>
      </div>
    </section>
  </main>
</Layout>

<!-- VIDEO LIGHTBOX -->
<div
  id="video-lightbox"
  class="video-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Arts and entertainment video player"
  aria-hidden="true"
  tabindex="-1"
>
  <button type="button" class="lightbox-close" aria-label="Close video">
    &times;
  </button>

  <div class="lightbox-video-container">
    <iframe
      id="lightbox-player"
      title="Arts and entertainment video"
      src=""
      allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
      allowfullscreen></iframe>
  </div>
</div>

<script>
  const lightbox = document.getElementById("video-lightbox");

  const player = document.getElementById(
    "lightbox-player",
  ) as HTMLIFrameElement | null;

  const closeButton = document.querySelector(
    ".lightbox-close",
  ) as HTMLButtonElement | null;

  const videoButtons = document.querySelectorAll(
    ".film-thumbnail[data-video-id]",
  );

  let previousFocus: HTMLElement | null = null;

  function openLightbox(videoId: string) {
    if (!lightbox || !player) return;

    previousFocus = document.activeElement as HTMLElement;

    player.src =
      `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}` +
      `?autoplay=1&rel=0&playsinline=1`;

    lightbox.classList.add("active");
    lightbox.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";

    closeButton?.focus();
  }

  function closeLightbox() {
    if (!lightbox || !player) return;

    lightbox.classList.remove("active");
    lightbox.setAttribute("aria-hidden", "true");

    player.src = "";

    document.body.style.overflow = "";

    previousFocus?.focus();
  }

  videoButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const videoId = (button as HTMLElement).dataset.videoId;

      if (videoId) {
        openLightbox(videoId);
      }
    });
  });

  closeButton?.addEventListener("click", closeLightbox);

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (!lightbox?.classList.contains("active")) return;

    if (event.key === "Escape") {
      closeLightbox();
    }

    if (event.key === "Tab") {
      event.preventDefault();
      closeButton?.focus();
    }
  });
</script>
