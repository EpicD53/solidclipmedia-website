---
import Layout from "../layouts/Layout.astro";

const socialMediaProjects = [
  {
    title: "Brand Awareness",
    category: "PROMOTIONAL CONTENT",
    description:
      "Showcasing Quality Age Build’s expertise in basement underpinning and foundation work. SolidClip Media handled filming, editing, voice-over sourcing, and custom logo animation to create a professional promotional video that highlights the company’s craftsmanship and services. ",
    instagramUrl: "https://www.instagram.com/reel/CxONhhUsqtX/",
    views: "27.7K",
  },
  {
    title: "Event Highlight Reel",
    category: "BRAND BOOST",
    description:
      "A 60-second highlight reel capturing the energy, passion, and excitement of Barvinok Ukrainian Dance School’s performances. Through dynamic filming and rhythmic editing, Solid Clip Media brings the vibrant costumes, traditional choreography, and spirit of Ukrainian dance to life.",
    instagramUrl: "https://www.instagram.com/reel/Cr3yd9sJ6Pa",
    views: "17.3K",
  },
  {
    title: "Personal Lifestyle ",
    category: "CREATIVE STORYTELLING",
    description:
      "A one-hour gym filming session transformed into a high-energy fitness video. ",
    instagramUrl: "https://www.instagram.com/reel/ChQk_y9lYO4",
    views: "18.7K",
  },
];
---

<Layout
  title="Social Media Videography | Solid Clip Media"
  description="Professional social media video production in Toronto and the GTA. Short-form videos, Instagram Reels, promotional content, and creative storytelling by Solid Clip Media."
>
  <main class="socialmedia-page">
    <!-- HERO -->
    <section class="socialmedia-hero">
      <span class="socialmedia-label">SOLID CLIP MEDIA</span>

      <h1>Social Media Content</h1>

      <p>
        Short-form videos that capture attention, tell your story, and leave a
        lasting impression.
      </p>
    </section>

    <!-- INTRO -->
    <!-- <section class="socialmedia-intro">
      <h2>Make Every Second Count.</h2>

      <p>
        In a world where attention spans are short, every second matters. We
        create engaging, professionally produced social media videos that help
        brands, businesses, and creators stand out.
      </p>
    </section> -->

    <!-- VIDEO EXAMPLES -->
    <section class="socialmedia-projects">
      <div class="socialmedia-projects-heading">
        <span class="socialmedia-label">OUR WORK</span>

        <h2>Featured Content</h2>

        <p>
          A selection of short-form videos created to engage, inspire, and
          connect.
        </p>
      </div>
      <div class="socialmedia-video-grid">
        {
          socialMediaProjects.map((project) => (
            <article class="socialmedia-card">
              <div class="socialmedia-video">
                <iframe
                  src={`${project.instagramUrl.replace(/\/$/, "")}/embed/`}
                  title={project.title}
                  loading="lazy"
                  allow="autoplay; encrypted-media; picture-in-picture"
                  allowfullscreen
                />
              </div>

              <div class="socialmedia-card-info">
                <span class="socialmedia-category">{project.category}</span>

                <h3>{project.title}</h3>

                <p>{project.description}</p>

                {project.views && (
                  <div class="socialmedia-views">
                    <i class="fa fa-eye" aria-hidden="true" />
                    <span>{project.views} views</span>
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- INQUIRY FORM -->
    <section class="corporate-inquiry" id="corporate-inquiry">
      <div class="corporate-inquiry-container">
        <!-- HEADING -->
        <div class="corporate-inquiry-heading">
          <span class="corporate-inquiry-label">LET'S WORK TOGETHER</span>

          <h2>Ready to Stand Out?</h2>

          <p>
            Whether you're promoting your business, launching a campaign, or
            building your online presence, let's create something worth
            watching.
          </p>
        </div>

        <form
          name="socialmedia-inquiry"
          method="POST"
          action="/thank-you"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="corporate-inquiry-form"
        >
          <input type="hidden" name="form-name" value="socialmedia-inquiry" />

          <!-- Spam protection -->
          <p class="corporate-honeypot">
            <label>
              Don't fill this out:
              <input name="bot-field" />
            </label>
          </p>

          <!-- NAME + EMAIL -->
          <div class="corporate-form-row">
            <div class="corporate-form-field">
              <label for="corporate-name">Your Name *</label>

              <input
                type="text"
                id="corporate-name"
                name="name"
                placeholder="John Smith"
                autocomplete="name"
                required
              />
            </div>

            <div class="corporate-form-field">
              <label for="corporate-email">Email Address *</label>

              <input
                type="email"
                id="corporate-email"
                name="email"
                placeholder="john@example.com"
                autocomplete="email"
                required
              />
            </div>
          </div>

          <!-- PHONE NUMBER -->
          <div class="corporate-form-field">
            <label for="corporate-phone">Phone Number</label>

            <input
              type="tel"
              id="corporate-phone"
              name="phone"
              placeholder="(416) 555-1234"
              autocomplete="tel"
            />
          </div>

          <!-- PROJECT DETAILS -->
          <div class="corporate-form-field">
            <label for="corporate-message">Tell Us About Your Project *</label>

            <textarea
              id="corporate-message"
              name="message"
              rows="5"
              placeholder="Tell us a little about your project, what you're hoping to achieve, and any other important details..."
              required></textarea>
          </div>

          <!-- SUBMIT BUTTON -->
          <button type="submit" class="corporate-form-submit">
            Send Your Inquiry
            <span aria-hidden="true">↗</span>
          </button>

          <p class="corporate-form-note">
            No commitment required. We'll review your project details and get
            back to you to discuss the next steps.
          </p>
          <p class="contact-alternative">
            Prefer email?&nbsp;
            <a href="mailto:solidclipmedia@gmail.com">
              solidclipmedia@gmail.com
            </a>
          </p>
        </form>
      </div>
    </section>
  </main>
</Layout>
