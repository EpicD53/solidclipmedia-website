---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import PortfolioGrid from "../components/PortfolioGrid.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import RatingStrip from "../components/RatingStrip.astro";
---

<Layout
  title="Solid Clip Media | Professional Videography"
  description="Professional cinematography, wedding videography, and visual storytelling in Toronto, Ontario."
>
  <Header />
  <main id="top">
    <!-- CINEMATIC VIDEO HERO -->
    <Hero />
    <RatingStrip />

    <!-- PORTFOLIO -->
    <PortfolioGrid />

    <section class="reviews-section" id="reviews">
      <div class="reviews-heading">
        <p class="reviews-eyebrow">CLIENT EXPERIENCES</p>
        <h2>Don't Just Take Our Word For It.</h2>
      </div>

      <div class="reviews-container">
        <div class="review-card">
          <div class="review-header">
            <div class="review-stars" aria-label="5 out of 5 stars">★★★★★</div>
            <time class="review-date" datetime="2026-09-14"> August 2026 </time>
          </div>

          <p class="review-text">
            "It was a pleasure working with Andrew! Our highlight clip was so
            incredible, we genuinely felt like we were watching a movie trailer.
            The quality, storytelling, and attention to detail were exceptional.
            He captured all the special moments so beautifully, and we couldn’t
            be happier with our wedding video!"
          </p>

          <p class="review-author">— Diana Harasym</p>
        </div>

        <div class="review-card">
          <div class="review-header">
            <div class="review-stars" aria-label="5 out of 5 stars">★★★★★</div>
            <time class="review-date" datetime="2026-09-14">
              October 2024
            </time>
          </div>
          <p class="review-text">
            "Andrew was very professional and delivered a product well beyond
            expectations. Not only does he produce a quality product, but he is
            able to skillfully incorporate feedback from the client (in this
            case our company) to make sure all of our needs are met."
          </p>

          <p class="review-author">— Eric Dumais</p>
        </div>

        <div class="review-card">
          <div class="review-header">
            <div class="review-stars" aria-label="5 out of 5 stars">★★★★★</div>
            <time class="review-date" datetime="2026-09-14">
              December 2024
            </time>
          </div>
          <p class="review-text">
            "...Working with Andrew is more than collaboration, it’s witnessing
            someone who genuinely loves what they do and pours their soul into
            every detail. I deeply admire his passion, his drive, and the
            powerful energy he brings to every endeavor."
          </p>

          <p class="review-author">— Mushtaq Sayed</p>
        </div>
      </div>
    </section>
    <section class="about-section" id="about">
      <div class="about-container">
        <!-- LEFT: PHOTO -->
        <!-- LEFT: PHOTO COLLAGE -->
        <div class="about-image-grid">
          <div class="about-photo about-photo-top">
            <img
              src="/images/about-landscape-1.jpg"
              alt="Solid Clip Media behind the scenes"
              loading="lazy"
            />
          </div>

          <div class="about-photo about-photo-bottom">
            <img
              src="/images/about-landscape-2.jpg"
              alt="Professional videography equipment"
              loading="lazy"
            />
          </div>

          <div class="about-photo about-photo-portrait">
            <img
              src="/images/about-photo.jpg"
              alt="Solid Clip Media filmmaker"
              loading="lazy"
            />
          </div>
        </div>

        <!-- RIGHT: DESCRIPTION -->
        <div class="about-content">
          <span class="about-label">GET TO KNOW US</span>

          <h2>
            Behind the<span> Lens.</span>
          </h2>

          <div class="about-divider"></div>

          <p class="about-description">
            SolidClip Media is a Toronto-based videography company dedicated to
            capturing stories through cinematic visuals and thoughtful
            storytelling.
          </p>

          <p class="about-description">
            <!-- Add your personal description here -->
            From weddings and special events to corporate productions, we approach
            every project with creativity, attention to detail, and a commitment to
            delivering something memorable.
          </p>

          <a href="/#contact-container" class="about-button">
            Let's Work Together <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact-container">
      <div class="contact-wrapper">
        <div class="contact-heading">
          <span class="contact-label">LET'S TALK</span>

          <h2>Let's Create Something Solid.</h2>

          <p class="contact-description">
            Have a project in mind? Tell us a little about it, and we'll get
            back to you.
          </p>
        </div>

        <form
          name="contact"
          method="POST"
          action="/thank-you"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="contact-form"
        >
          <input type="hidden" name="form-name" value="contact" />

          <!-- Spam protection -->
          <p class="contact-honeypot">
            <label>
              Don't fill this out:
              <input name="bot-field" />
            </label>
          </p>

          <div class="contact-row">
            <div class="contact-field">
              <label for="contact-name">Your Name</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                placeholder="John Smith"
                autocomplete="name"
                required
              />
            </div>
          </div>
          <div class="contact-field">
            <label for="contact-email">Email Address</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              placeholder="john@example.com"
              autocomplete="email"
              required
            />
          </div>

          <div class="contact-field">
            <label for="contact-project">What type of project?</label>
            <select id="contact-project" name="project_type" required>
              <option value="" disabled selected>Select a project type</option>
              <option value="Wedding">Wedding</option>
              <option value="Corporate">Corporate</option>
              <option value="Social Event">Social Event</option>
              <option value="Real Estate">Real Estate</option>
              <option value="Performance">Performance</option>
              <option value="Social Media">Social Media</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="contact-field">
            <label for="contact-message">Tell us about your project</label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              placeholder="Tell us what you have in mind..."
              required></textarea>
          </div>

          <button type="submit" class="contact-submit">
            Send Inquiry <span aria-hidden="true">↗</span>
          </button>

          <p class="contact-alternative">
            Prefer email?
            <a href="mailto:solidclipmedia@gmail.com">
              solidclipmedia@gmail.com
            </a>
          </p>
        </form>
      </div>
    </section>
  </main>
</Layout>
