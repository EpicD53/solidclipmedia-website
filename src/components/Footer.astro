  <SocialIcons />
  <div class="footer-content">
    <div id="last-comments">
      <p>Good things take time (and so does coding this website)</p>

      <p>
        &copy; 2022-{currentYear} SolidClip Media. All Rights Reserved
      </p>

      <p>Toronto, Ontario</p>

      <div id="dec-line"></div>

      <br />

      <a href="#top" id="jump-to-top">Jump to Top</a>

      <img
        src="/images/two buttons 300ppi.png"
        alt="Two SolidClip Media buttons"
        id="two-buttons"
      />
    </div>
  </div>
</footer>
